# Copy these into your hosting provider's environment settings.
# This project does not read a .env file by itself: Django only reads real
# environment variables. Never commit real values.

DJANGO_DEBUG=0
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=shop.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://shop.example.com
DJANGO_HSTS_SECONDS=0
DJANGO_BEHIND_PROXY=0

ZSTORE_SHIPPING_FEE=
ZSTORE_FREE_SHIPPING_THRESHOLD=
ZSTORE_VODAFONE_CASH_NUMBER=
ZSTORE_INSTAPAY_ADDRESS=

# Cloudinary media storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
